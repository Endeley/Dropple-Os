{
    "name": "dropple",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "arch": "node enforceDroppleLaws.cjs",
        "dev": "NEXT_DIST_DIR=.next-dev next dev",
        "dev:stable": "NEXT_DISABLE_DEVTOOLS=1 NEXT_DIST_DIR=.next-dev next dev",
        "build": "NEXT_DIST_DIR=.next-prod next build",
        "build:smoke": "NEXT_DIST_DIR=.next-prod next build",
        "build:e2e": "node scripts/buildE2e.mjs",
        "start": "NEXT_DIST_DIR=.next-prod next start",
        "start:e2e": "DROPPLE_E2E=1 NEXT_PUBLIC_CONVEX_URL= NEXT_DIST_DIR=$(node -e \"const os=require('os');const path=require('path');process.stdout.write(path.join(os.tmpdir(),'dropple-next-e2e'))\") next start",
        "lint": "eslint",
        "enforce:laws": "node enforceDroppleLaws.cjs",
        "lint:export": "node scripts/dropple-export-gate.mjs --world ./fixtures/worlds/allow.json --width 1440 --height 900",
        "lint:export:json": "node scripts/dropple-export-gate.mjs --world ./fixtures/worlds/allow.json --width 1440 --height 900 --json",
        "create:workspace": "node scripts/createWorkspace.js",
        "architecture:monitor": "node scripts/architectureMonitor.mjs",
        "architecture:score": "node scripts/architectureScore.mjs",
        "architecture:radar": "node scripts/architectureRadar.mjs",
        "architecture:phase": "node scripts/architecturePhaseProgress.mjs",
        "architecture:transition:audit": "node scripts/architectureTransitionAudit.mjs",
        "architecture:guard": "node scripts/architectureGuard.mjs",
        "architecture:ci": "node scripts/architectureCi.mjs && node scripts/architectureGuard.mjs",
        "architecture:drift": "node scripts/architectureDrift.mjs",
        "implementation:navigator": "node scripts/implementationNavigator.mjs",
        "migration:legacy-scan": "node scripts/scanLegacyModeDependencies.mjs",
        "template:registry:migrate": "node scripts/migrateCertifiedTemplatesToLineage.mjs",
        "engine:test": "node engine/evaluation/evaluateScene.fixture.test.mjs",
        "engine:shot:test": "node engine/evaluation/evaluateShotAt.fixture.test.mjs && node --import ./bench/register-alias-loader.mjs --test engine/evaluation/evaluateShotAt.temporalComposition.test.mjs runtime/transition/__tests__/evaluateTransitionFrame.test.mjs",
        "engine:track:test": "node engine/__tests__/trackContract.test.mjs",
        "engine:timeline:test": "node engine/__tests__/timelineContract.test.mjs",
        "engine:dispatcher:test": "node engine/__tests__/trackDispatcher.test.mjs",
        "engine:projection:test": "node engine/__tests__/timelineProjection.test.mjs",
        "engine:timeline:evaluate:test": "node engine/__tests__/evaluateTimeline.test.mjs",
        "engine:timeline:history:test": "node engine/__tests__/timelineHistory.test.mjs",
        "engine:timeline:controller:test": "node engine/__tests__/timelineController.test.mjs",
        "engine:timeline:controller:diff:test": "node engine/__tests__/timelineController.diff.test.mjs",
        "engine:timeline:diff:test": "node engine/__tests__/diffTimeline.test.mjs",
        "engine:export:stability:test": "node engine/__tests__/exportStabilityGate.test.mjs",
        "engine:track:lock:test": "node engine/__tests__/trackLock.test.mjs",
        "engine:track:blend:test": "node engine/__tests__/trackBlendMode.test.mjs",
        "engine:track:group:test": "node engine/__tests__/trackGrouping.test.mjs",
        "engine:timeline:dag:test": "node engine/__tests__/snapshotDag.test.mjs",
        "engine:timeline:label:test": "node engine/__tests__/snapshotLabeling.test.mjs",
        "runtime:map:test": "node --import ./bench/register-alias-loader.mjs runtime/animation/buildEvaluationInputs.fixture.test.mjs",
        "runtime:replay:test": "node --import ./bench/register-alias-loader.mjs runtime/__tests__/runtimeReplayDeterminism.test.mjs",
        "runtime:statehash:test": "node --import ./bench/register-alias-loader.mjs runtime/__tests__/runtimeStateHash.test.mjs",
        "runtime:resize:session:test": "node --import ./bench/register-alias-loader.mjs runtime/__tests__/resizeSessionDeterminism.test.mjs && node --import ./bench/register-alias-loader.mjs runtime/__tests__/resizeSessionCommitBridge.test.mjs",
        "ui:interactions:test": "node scripts/architectureTransitionAudit.mjs",
        "test:engine:all": "node scripts/runDiscoveredTests.mjs engine ./bench/register-alias-loader.mjs",
        "test:runtime:all": "node scripts/runDiscoveredTests.mjs runtime ./bench/register-alias-loader.mjs",
        "test:system:runtime": "node --import ./bench/register-alias-loader.mjs --test tests/system/*.test.mjs",
        "test:system:app": "npm run validate:app",
        "test:system:all": "npm run test:system:runtime && npm run test:system:app",
        "test:core:all": "npm run test:engine:all && npm run test:runtime:all",
        "test:all": "npm run test:core:all && npm run test:kernel && npm run test:architecture && npm run ui:interactions:test",
        "test:kernel": "node --import ./tests/register-test-loaders.mjs --test tests/kernel/*.test.ts",
        "test:architecture": "node --import ./tests/register-test-loaders.mjs --test tests/architecture/*.test.ts",
        "test:routes:smoke": "npm run build:e2e && PLAYWRIGHT_SKIP_BUILD=1 playwright test tests/e2e",
        "determinism": "NODE_ENV=test node scripts/determinismGate.mjs",
        "performance:determinism": "NODE_ENV=test node scripts/performanceDeterminismGate.mjs",
        "ci:determinism": "npm run determinism",
        "template:verify-all": "NODE_ENV=test node scripts/templateVerifyAll.mjs",
        "release:trust:report": "node --import ./bench/register-alias-loader.mjs scripts/releaseTrustReport.mjs",
        "release:trust:ledger": "node --import ./bench/register-alias-loader.mjs scripts/releaseTrustLedger.mjs append",
        "release:trust:ledger:verify": "node --import ./bench/register-alias-loader.mjs scripts/releaseTrustLedger.mjs verify",
        "release:federation:lineage": "node --import ./bench/register-alias-loader.mjs scripts/federationAuditLineageReport.mjs",
        "release:federation:lineage:ledger": "node --import ./bench/register-alias-loader.mjs scripts/federationAuditLineageLedger.mjs append",
        "release:federation:lineage:ledger:verify": "node --import ./bench/register-alias-loader.mjs scripts/federationAuditLineageLedger.mjs verify",
        "test:federation:release": "node --import ./tests/register-test-loaders.mjs --test tests/kernel/createSessionFederationContract.test.ts tests/kernel/sessionFederationOrchestrationContract.test.ts tests/kernel/federationAuditRuntime.test.ts && node --import ./bench/register-alias-loader.mjs --test tests/release/releaseFederationAttestationGate.test.mjs",
        "release:trust:diff": "node --import ./bench/register-alias-loader.mjs scripts/releaseTrustDiff.mjs",
        "release:trust:summary": "node --import ./bench/register-alias-loader.mjs scripts/releaseTrustSummary.mjs",
        "release:trust:pr-comment": "node --import ./bench/register-alias-loader.mjs scripts/releaseTrustPrComment.mjs",
        "release:trust:baseline:capture": "node --import ./bench/register-alias-loader.mjs scripts/releaseTrustCaptureBaseline.mjs",
        "test:release:attestation": "node --import ./bench/register-alias-loader.mjs --test tests/release/*.test.mjs",
        "test:release:operator-surfaces": "node --import ./bench/register-alias-loader.mjs --test tests/release/releaseTrustSummaryCli.test.mjs tests/release/releaseTrustProbeSummaryCli.test.mjs tests/release/releaseTrustPrComment.test.mjs tests/release/releaseTrustOperatorSurfacesUmbrella.test.mjs",
        "validate:all": "npm run test:all && npm run test:system:all && npm run determinism && npm run architecture:ci",
        "validate:release": "npm run validate:all && npm run performance:determinism && npm run template:verify-all && npm run test:federation:release && npm run test:release:attestation && npm run release:trust:report && npm run release:federation:lineage",
        "validate:app": "npm run build:smoke && npm run test:routes:smoke"
    },
    "dependencies": {
        "@stackframe/stack": "^2.8.56",
        "clsx": "^2.1.1",
        "convex": "^1.31.2",
        "dotenv": "^17.3.1",
        "lucide-react": "^0.562.0",
        "nanoid": "^5.1.6",
        "next": "^15.5.9",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "uuid": "^11.1.0",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@tailwindcss/postcss": "^4.1.18",
        "@types/node": "^25.0.3",
        "@types/react": "^19.2.7",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "^9.39.2",
        "eslint-config-next": "15.5.0",
        "postcss": "^8.4.49",
        "tailwindcss": "^4.1.18",
        "type-check": "^0.4.0"
    }
}
